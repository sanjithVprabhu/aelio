{
  "name": "aelio",
  "version": "0.1.0",
  "private": true,
  "description": "Aelio — conversational intelligence for SaaS platforms",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev": "turbo dev",
    "api": "pnpm --filter @aelio/api dev",
    "demo": "pnpm --filter @aelio/api demo",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
