{
  "name": "aelio",
  "version": "0.1.0",
  "private": true,
  "description": "Aelio — conversational intelligence for SaaS platforms",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev": "turbo dev",
    "api": "pnpm --filter @aelio/api dev",
    "demo:backend": "pnpm --filter @aelio/demo-customer-backend dev",
    "widget:build": "pnpm --filter @aelio/widget-sdk build",
    "stack": "docker-compose up -d postgres sunjet sunjet-daemon && pnpm widget:build",
    "demo:live": "pnpm widget:build && echo 'Run: pnpm api:live  (terminal 1)  &&  pnpm demo:backend:live  (terminal 2)'",
    "api:live": "pnpm --filter @aelio/api start",
    "demo:backend:live": "pnpm --filter @aelio/demo-customer-backend start",
    "demo": "pnpm --filter @aelio/api demo",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
