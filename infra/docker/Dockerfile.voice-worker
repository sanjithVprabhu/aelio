# syntax=docker/dockerfile:1.7
#
# apps/voice-worker — Real-time Voice (Fastify + native WebSocket), Node 22.
# Each call holds one WebSocket (Twilio media stream <-> Deepgram/ElevenLabs).
# Vertical-first scaling; sticky sessions enforced at the Service level (§11.4).
#
# Build context MUST be the monorepo root:
#   docker build -f infra/docker/Dockerfile.voice-worker -t aelio/voice-worker .
#
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @aelio/voice-worker... build

# ---------------------------------------------------------------------------
# Runtime — slim, non-root.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo
USER node
COPY --chown=node:node --from=build /repo .

ENV APP_NAME=voice-worker
ENV PORT=3200
EXPOSE 3200

# First-audio latency is the key SLI; liveness still uses /healthz.
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3200)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["pnpm", "--filter", "@aelio/voice-worker", "start"]
