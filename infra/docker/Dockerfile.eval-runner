# syntax=docker/dockerfile:1.7
#
# apps/eval-runner — Offline Eval Harness, Node 22.
# Runs as a Kubernetes Job (spawned per eval run by apps/api) or a
# BullMQ-triggered worker. Shares modules with apps/api (§11.5).
# Per-scenario timeout enforced at 5 minutes by the app itself.
#
# Build context MUST be the monorepo root:
#   docker build -f infra/docker/Dockerfile.eval-runner -t aelio/eval-runner .
#
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @aelio/eval-runner... build

# ---------------------------------------------------------------------------
# Runtime — slim, non-root. No long-running server; runs the suite and exits.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo
USER node
COPY --chown=node:node --from=build /repo .

ENV APP_NAME=eval-runner
# No EXPOSE: this is a batch Job, not a service.
# Runs `tsx` start script; the process exits when the eval run completes.
CMD ["pnpm", "--filter", "@aelio/eval-runner", "start"]
