# syntax=docker/dockerfile:1.7
#
# apps/admin — SaaS-Facing Dashboard (Next.js 15 App Router, React 19), Node 22.
# Built with `next build`, served with `next start`. When self-hosted on EKS
# this image sits behind CloudFront/ALB; static assets are CDN-cached (§11.2).
#
# Build context MUST be the monorepo root:
#   docker build -f infra/docker/Dockerfile.admin -t aelio/admin .
#
# NOTE: NEXT_PUBLIC_* values are inlined at build time. Pass the public ones as
# build args; keep server-only secrets (CLERK_SECRET_KEY) as runtime env.
#
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
# Public env baked into the client bundle at build time.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_WS_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @aelio/admin... build

# ---------------------------------------------------------------------------
# Runtime — slim, non-root, runs the Next.js production server.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo
USER node
COPY --chown=node:node --from=build /repo .

ENV APP_NAME=admin
ENV PORT=3001
EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# `next start` (via the app's start script) serves the production build.
CMD ["pnpm", "--filter", "@aelio/admin", "start"]
