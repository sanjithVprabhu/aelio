# Copy to terraform.tfvars and fill in. Do NOT commit real terraform.tfvars.
environment        = "prod"
region             = "ap-south-1"
vpc_cidr           = "10.40.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]
kubernetes_version = "1.30"

app_role_arns = [
  # "arn:aws:iam::123456789012:role/aelio-api",
]

acm_certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/REPLACE_ME"
waf_web_acl_arn     = null

dr_destination_region      = "eu-west-1"
dr_destination_kms_key_arn = "arn:aws:kms:eu-west-1:123456789012:key/REPLACE_ME"

pagerduty_endpoint = null
slack_endpoint     = null
