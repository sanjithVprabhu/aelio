# Aelio environment template. Copy to `.env` and then edit values there.
# Do not rely on this file as the live runtime config.
#
# Everything is OPTIONAL — unset means the simplest local
# Aelio runtime boot:
# - in-memory persistence
# - scripted LLM
# - built-in demo tenant
# - mock provider transports
#
# Set the real backends below to move toward production mode.

# ---- Core ----
NODE_ENV=development
PORT=3100
BASE_URL=http://localhost:3100
LOG_LEVEL=info
# AELIO_ALLOW_IN_MEMORY=1      # default: 1. Set to 0 to require DATABASE_URL.
# AELIO_ENABLE_DEMO_ROUTES=1   # default: 1. Set to 0 to hide /demo/* pages.

# ---- Persistence (real Postgres + Redis) ----
# When DATABASE_URL is set, Aelio persists tenant/runtime data in Postgres and
# mirrors writes through to the database. Without it, Aelio still boots in
# local single-runtime mode using in-memory persistence.
# DATABASE_URL=postgres://dev:dev@localhost:5470/aelio_dev
# REDIS_URL=redis://localhost:6390

# ---- Google Gemini (LLM + embeddings) ----
# When GEMINI_API_KEY is set, the platform defaults to Google for both resolve/synthesize
# LLM calls and SunJet/pgvector memory embeddings (unless overridden below).
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001

# ---- Encryption (dev defaults applied automatically in development/test) ----
# MASTER_ENCRYPTION_KEY=<64 hex chars / 32 bytes>
# INTERNAL_SERVICE_SECRET=<>=32 chars; shared with the workers>

# ---- Other LLM providers (optional) ----
# LLM_PROVIDER=openai|anthropic|google|scripted
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=          # legacy alias for GEMINI_API_KEY

# ---- SunJet memory core (optional for local dev, internal to Aelio in production) ----
# MEMORY_ENGINE=sunjet
# SUNJET_URL=http://127.0.0.1:8090   # local release binaries (recommended for dev)
# SUNJET_API_KEY=dev_sunjet_key
# SUNJET_DAEMON_URL=http://127.0.0.1:8091
# SUNJET_DAEMON_API_KEY=dev_daemon_key
# Docker compose uses 8080/8081 — rebuild images after SunJet changes:
#   docker compose -f docker-compose.stack.yml up -d --build --force-recreate sunjet sunjet-daemon

# ---- Convox demo customer backend ----
# CONVOX_IN_PROCESS=0   # 0 = real WS to acme-convox (Postgres SaaS); 1 = in-memory handlers in API
# AELIO_BASE_URL=http://localhost:3100
# AELIO_API_KEY=test_api_key
# AELIO_TENANT_SLUG=acme
# ACME_CONVOX_PORT=3101
# AELIO_CUSTOMER_BACKEND_URL=http://localhost:3101
# DEMO_CONVOX_API_KEY=test_api_key

# ---- LLM observability (Langfuse) ----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- channel-worker transports (real when set, else mock) ----
# META_PHONE_NUMBER_ID=          # WhatsApp Cloud API
# META_ACCESS_TOKEN=
# META_APP_SECRET=               # webhook signature verification
# TWILIO_ACCOUNT_SID=            # SMS
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# SLACK_BOT_TOKEN=               # Slack chat.postMessage
# SLACK_SIGNING_SECRET=

# ---- voice-worker (real when set, else mock STT/TTS) ----
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# ---- worker → api mesh ----
API_BASE_URL=http://localhost:3000
