# Aelio environment. Everything is OPTIONAL — unset means the zero-infra default
# (in-memory store, scripted LLM, mock provider transports). Set these to switch
# on the real production backends.

# ---- Core ----
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Persistence (real Postgres + Redis) ----
# When set, apps/api migrates + hydrates from Postgres and mirrors writes through;
# sessions / rate-limits / tokens move to Redis; BullMQ uses Redis.
DATABASE_URL=postgres://dev:dev@localhost:5470/aelio_dev
REDIS_URL=redis://localhost:6390

# ---- Encryption (dev defaults applied automatically in development/test) ----
# MASTER_ENCRYPTION_KEY=<64 hex chars / 32 bytes>
# INTERNAL_SERVICE_SECRET=<>=32 chars; shared with the workers>

# ---- LLM provider (default: scripted, deterministic, offline) ----
# LLM_PROVIDER=anthropic|openai|google|scripted
# LLM_MODEL=claude-sonnet-4-6        # or gpt-4o, gemini-1.5-pro, ...
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# ---- LLM observability (Langfuse) ----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- channel-worker transports (real when set, else mock) ----
# META_PHONE_NUMBER_ID=          # WhatsApp Cloud API
# META_ACCESS_TOKEN=
# META_APP_SECRET=               # webhook signature verification
# TWILIO_ACCOUNT_SID=            # SMS
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# SLACK_BOT_TOKEN=               # Slack chat.postMessage
# SLACK_SIGNING_SECRET=

# ---- voice-worker (real when set, else mock STT/TTS) ----
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# ---- worker → api mesh ----
API_BASE_URL=http://localhost:3000
